{
  "name": "ferret-den",
  "version": "1.1.0",
  "description": "MCP server serving the Warren's recon kit under ferret names. The agent meets whisker, fang, and the den — the warren's own labels never surface.",
  "type": "module",
  "bin": {
    "ferret-den": "./build/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "dev": "tsc --watch",
    "start": "bun src/index.ts",
    "install-bins": "bun scripts/install.ts",
    "check-bins": "bun scripts/install.ts --check"
  },
  "keywords": [
    "mcp",
    "ferret-den",
    "the-warren",
    "reconnaissance"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "files": [
    "build"
  ]
}
